{
  "appId": "com.alsomhy.accounting",
  "productName": "GroceryAccounting",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/better-sqlite3/**/*"
  ],
  "asarUnpack": [
    "**/*.node"
  ],
  "win": {
    "target": [
      "portable",
      "nsis"
    ]
  }
}
